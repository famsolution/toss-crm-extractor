{
  "manifest_version": 3,
  "name": "토스인슈 CRM 데이터 추출기",
  "version": "3.22.3",
  "description": "토스인슈 CRM 데이터 추출 — 마스킹 자동 복원 + 로그인/관리자 승인 권한 게이트.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "scripting",
    "debugger",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://crm.tossinsu.com/*",
    "https://mmlfcp.ohmymanager.com/*",
    "https://*.ohmymanager.com/*",
    "file:///*",
    "http://localhost/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "토스인슈 CRM 추출기"
  },
  "content_scripts": [
    {
      "matches": [
        "https://crm.tossinsu.com/*",
        "https://mmlfcp.ohmymanager.com/*",
        "https://*.ohmymanager.com/*",
        "https://tossinssu-pro.vercel.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://erp.samsungfire.com/*",
        "*://sp.hi.co.kr/*",
        "*://www.mdbins.com/*",
        "*://sales.meritzfire.com/*",
        "*://nsso.meritzfire.com/*",
        "*://sales.kbinsure.co.kr/*",
        "*://portal.hwgeneralins.com/*",
        "*://sales.heungkukfire.co.kr/*",
        "*://lottero.lotteins.co.kr/*",
        "*://ss.nhfire.co.kr/*",
        "*://mganet.mggeneralins.com/*",
        "*://ga.shinhanez.co.kr/*",
        "*://ga.aig.co.kr/*",
        "*://sfa.saleshana.com/*",
        "*://ga.samsunglife.com/*",
        "*://hmp.hanwhalife.com/*",
        "*://ga.kyobo.com/*",
        "*://ga.shinhanlife.co.kr/*",
        "*://ga.lina.co.kr/*",
        "*://ga.abllife.co.kr/*",
        "*://ga.hanalife.co.kr/*",
        "*://brand.metlife.co.kr/*",
        "*://sfa.kblife.co.kr/*",
        "*://sfa.nhlife.co.kr/*",
        "*://sales.heungkuklife.co.kr/*",
        "*://ez.fubonhyundai.com/*",
        "*://etopia.dongbulife.com/*",
        "*://kss.kdblife.co.kr/*",
        "*://ga.cardif.co.kr/*",
        "*://fgs.imlifeins.co.kr/*"
      ],
      "js": [
        "insurer-fill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "_comment": "?sp=1 — popup-ctx.js 가 이 문서를 사이드패널로 판별하는 표시. 빼면 사이드패널이 800px 고정폭으로 잘린다.",
    "default_path": "popup.html?sp=1"
  },
  "web_accessible_resources": [
    {
      "_comment": "pcs-clip-intercept.js — 이름은 pcs 로 시작하지만 금소법과 무관. 토스 '이미지 복사'를 가로채 보장분석 표 이미지를 캡처(페인트프로 전송)하는 기능이므로 유지한다.",
      "resources": ["pcs-clip-intercept.js"],
      "matches": ["https://crm.tossinsu.com/*"]
    }
  ]
}
